# Copy the values you need from this file into the root .env or set them in PowerShell
# before running k6. This file is only a template and is not auto-loaded by k6-airgap-browser.mjs.

BASE_URL=https://your-target-site.example

# Reuse saved Microsoft login from Playwright auth bootstrap.
USE_AUTH_STATE=true
AUTH_STATE_PATH=./playwright-load/auth-state-ms.json
POST_LOGIN_URL_CONTAINS=your-target-site.example

# Load shape
CONCURRENCY=20
DURATION=2m
THINK_TIME_S=0.2
NAV_TIMEOUT_MS=60000
WAIT_SELECTOR=

# Cookie banner behavior
COOKIE_ACTION=script_loaded
AIRGAP_SCRIPT_MATCH=airgap.js
COOKIE_BANNER_SELECTOR=[id*=cookie], [class*=cookie], [aria-label*=cookie], [data-testid*=cookie], #transcend-consent-manager
COOKIE_ACCEPT_SELECTOR=button:has-text("Accept all"), button:has-text("Accept"), [id*=accept]
COOKIE_REJECT_SELECTOR=button:has-text("Reject all"), button:has-text("Reject"), [id*=reject]
COOKIE_MORE_SELECTOR=button:has-text("More choices"), button:has-text("Manage"), [id*=preferences]
COOKIE_EXPECTED_TEXT=Lilly and our partners use optional cookies for analytics, personalization, and marketing.